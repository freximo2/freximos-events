# Copia este archivo a .env.prod y reemplaza los valores. NUNCA lo subas con datos reales.

POSTGRES_USER=eventos
POSTGRES_PASSWORD=genera_con_openssl_rand_hex_24
POSTGRES_DB=eventos

# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 48
JWT_SECRET=genera_con_openssl_rand_hex_48

# Dominio público de producción
ALLOWED_ORIGINS=https://eventos.freximos.com
DATABASE_URL=postgresql://eventos:CONTRASENA@db:5432/eventos
PORT=3000
