FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 3000

# Producción: aplica migraciones versionadas (no borra datos) y arranca la API
CMD ["sh", "-c", "npx prisma migrate deploy && node src/index.js"]
