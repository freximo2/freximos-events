# Copia este archivo a .env y reemplaza los valores. NUNCA lo subas con datos reales.

POSTGRES_USER=vibrameet
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=vibrameet

# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_por_uno_de_al_menos_32_caracteres

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173

# Hosts públicos que Vite puede servir en desarrollo (separados por coma). Vacío = solo localhost.
VITE_ALLOWED_HOSTS=
